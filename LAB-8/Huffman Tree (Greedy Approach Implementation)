#include <stdio.h>

int f[20], t[20], r[20];
char ch[20];
int used[20] = {0};

void printcode(int root, char code[], int top)
{
    if (t[root] == -1 && r[root] == -1)
    {
        code[top] = '\0';
        printf("%c : %s\n", ch[root], code);
        return;
    }
    code[top] = '0';
    printcode(t[root], code, top + 1);
    code[top] = '1';
    printcode(r[root], code, top + 1);
}

int main()
{
    int n, i, j, x, y;
    char code[20];
    
    printf("Enter number of character: ");
    scanf("%d", &n);
    
    for (i = 0; i < n; i++)
    {
        printf("Enter character and frequency : ");
        scanf(" %c %d", &ch[i], &f[i]);
        t[i] = r[i] = -1;
    }
    
    for (i = n; i < 2 * n - 1; i++)
    {
        x = y = -1;
        for (j = 0; j < i; j++)
        {
            if (!used[j])
            {
                if (x == -1 || f[j] < f[x])
                {
                    y = x;
                    x = j;
                }
                else if (y == -1 || f[j] < f[y])
                {
                    y = j;
                }
            }
        }
        used[x] = used[y] = 1;
        f[i] = f[x] + f[y];
        ch[i] = '*';
        t[i] = x;
        r[i] = y;
    }
    
    printf("\n HUFFMAN CODE = \n");
    printcode(2 * n - 2, code, 0);
    return 0;
}
