#include <stdio.h>

int f[40], left[40], right[40], parent[40];
char ch[20];
long long totalbits = 0;

void printcode(int root, char code[], int top)
{
    if (left[root] == -1 && right[root] == -1)
    {
        if (top == 0)
            code[top] = '0';
        code[top] = '\0';
        printf("%c = %s\n", ch[root], code);
        totalbits += (long long)f[root] * top;
        return;
    }
    code[top] = '0';
    printcode(left[root], code, top + 1);
    code[top] = '1';
    printcode(right[root], code, top + 1);
}

int main()
{
    int n, i, j, x, y;
    char code[40];
    
    printf("enter no. of character = ");
    scanf("%d", &n);
    
    if (n < 2 || n > 20)
    {
        printf("enter btw 2 and 20 character\n");
        return 1;
    }
    
    for (i = 0; i < n; i++)
    {
        printf("enter character and frequency = ");
        scanf(" %c %d", &ch[i], &f[i]);
        left[i] = right[i] = parent[i] = -1;
    }
    
    for (i = n; i < 2 * n - 1; i++)
    {
        x = y = -1;
        for (j = 0; j < i; j++)
        {
            if (parent[j] == -1)
            {
                if (x == -1 || f[j] < f[x])
                {
                    y = x;
                    x = j;
                }
                else if (y == -1 || f[j] < f[y])
                {
                    y = j;
                }
            }
        }
        f[i] = f[x] + f[y];
        left[i] = x;
        right[i] = y;
        parent[i] = -1;
        parent[x] = parent[y] = i;
        ch[i] = '*';
    }
    
    printf("\n huffman codes : \n");
    printcode(2 * n - 2, code, 0);
    printf("\n total memory required = %lld bits\n", totalbits);
    printf("total memory required = %lld bytes\n", (totalbits + 7) / 8);
    return 0;
}
