#include <stdio.h>
int max(int a, int b) {
    return (a > b) ? a : b;
}
int maxsubarray(int a[], int l, int h) {
    if (l == h)
        return a[l];
    int mid = (l + h) / 2;
    int le, r, sum, lsum = -9999, rsum = -9999, i;
    le = maxsubarray(a, l, mid);
    r = maxsubarray(a, mid + 1, h);
    sum = 0;
    for (i = mid; i >= l; i--) {
        sum += a[i];
        lsum = max(lsum, sum);
    }
    sum = 0;
    for (i = mid + 1; i <= h; i++) {
        sum += a[i];
        rsum = max(rsum, sum);
    }
    return max(max(le, r), lsum + rsum);
}

int main() {
    int a[] = {-2, 1, -3, 4, -1, 2, 1, -5, 4};
    int n = 9;
    printf("maximum subarray sum = %d \n", maxsubarray(a, 0, n - 1));
    return 0;
}
