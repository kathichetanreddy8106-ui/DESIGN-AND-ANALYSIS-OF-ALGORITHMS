#include <stdio.h>
void strassen(int A[2][2], int B[2][2], int C[2][2]) {
    int a = A[0][0], b = A[0][1], c = A[1][0], d = A[1][1];
    int e = B[0][0], f = B[0][1], g = B[1][0], h = B[1][1];
    int m1 = (a + d) * (e + h);
    int m2 = (c + d) * e;
    int m3 = a * (f - h);
    int m4 = d * (g - e), m5 = (a + b) * h, m6 = (c - a) * (e + f);
    int m7 = (b - d) * (g + h);
    C[0][0] = m1 + m4 - m5 + m7;
    C[0][1] = m3 + m5;
    C[1][0] = m2 + m4;
    C[1][1] = m1 - m2 + m3 + m6;
}

int main() {
    int A[2][2] = {{1, 2}, {3, 4}};
    int B[2][2] = {{5, 6}, {7, 8}};
    int C[2][2] = {0, 0};
    int i, j;
    strassen(A, B, C);
    printf("result :\n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++) {
            printf("%d ", C[i][j]);
        }
        printf("\n");
    }
    return 0;
}
